{
    "name": "innoboxrr/search-surge",
    "description": "Filtrado, ordenamiento y paginacion declarativa para modelos Eloquent. Auto-descubre filtros por convencion, funciona igual dentro de una app o dentro de un paquete de Laravel.",
    "keywords": [
        "laravel",
        "eloquent",
        "search",
        "filter",
        "query",
        "pagination"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Innoboxrr\\SearchSurge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\SearchSurge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\SearchSurge\\Providers\\SearchSurgeServiceProvider"
            ],
            "aliases": {
                "SearchSurge": "Innoboxrr\\SearchSurge\\Facades\\SearchSurge"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "check": [
            "@lint:test",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test": "Ejecuta la suite de tests",
        "lint": "Aplica el estilo de codigo",
        "lint:test": "Comprueba el estilo sin modificar nada",
        "analyse": "Analisis estatico con PHPStan",
        "check": "Estilo + analisis + tests, lo mismo que hace CI"
    }
}
